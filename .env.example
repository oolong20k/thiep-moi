# ── Cách A: Vercel + Supabase (bật khi có SUPABASE_URL) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # Project Settings → API → service_role. Chỉ để ở server, không bao giờ để lộ ra client.
SITE_URL=                    # tuỳ chọn, vd https://thiep.example.com (mặc định lấy domain Vercel)

# ── Cách B: Local / Node.js (SQLite + ảnh trên đĩa): để trống SUPABASE_* ──
# DATA_DIR=./data            # nơi lưu app.db và uploads
